# ---- copy to .env and fill in, then: chmod 600 .env ----

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_MAIN=claude-sonnet-4-6

# Postgres (local on the Pi)
DATABASE_URL=postgres://unduruz:CHANGEME@localhost:5432/unduruz

# Dashboard auth. Long random string; you paste it in the browser once.
DASHBOARD_TOKEN=CHANGEME_long_random_string

# Bind to localhost only. Tailscale reaches it; the internet does not.
PORT=8787
HOST=127.0.0.1

# Webhook secrets from your processor dashboard
LEMON_WEBHOOK_SECRET=
GUMROAD_SELLER_ID=

# Images (optional). Cloudflare Workers AI free tier.
# Account ID: Cloudflare dashboard URL. Token: My Profile > API Tokens,
# template "Workers AI", read+run permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
DAILY_IMAGE_LIMIT=20

# Phone notifications (optional). Free, no account: pick an unguessable
# topic, then subscribe to it in the ntfy app on your phone.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Used to make notification links tappable, e.g. http://yourpi:8787
PUBLIC_URL=

# Near-duplicate detection (uses the same Cloudflare credentials).
# 1.0 is identical. Lower catches more, at the cost of false alarms.
DUPE_THRESHOLD=0.92

# Stop drafting once this many are waiting on you.
MAX_PENDING_REVIEW=8
# Hard ceiling on drafts per day: caps both volume and API spend.
DAILY_DRAFT_LIMIT=12
